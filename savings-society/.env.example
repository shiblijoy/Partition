# Database file. On a server use an absolute path outside the code folder,
# e.g. DATABASE_URL="file:/var/lib/dreamhive/dreamhive.db"
DATABASE_URL="file:./dev.db"

# Long random string that signs login sessions: generate with `openssl rand -hex 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Where uploaded proofs, receipts and documents are kept (default: ./storage).
# On a server: STORAGE_DIR="/var/lib/dreamhive/storage"
# STORAGE_DIR=""

# Used only by prisma/seed.ts. With SEED_DEMO=0 it creates just the first admin
# and the settings (no demo members), and the admin must set a new password at first login.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PHONE="01700000000"
SEED_ADMIN_EMAIL="admin@society.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# SEED_DEMO=0
# SEED_START_MONTH="2026-01"   # the society's first deposit month

# The public address of the app (used in receipt QR codes), e.g. https://dreamhive.example.org
APP_URL="http://localhost:3000"

# Key that encrypts NID numbers, addresses and nominee details: `openssl rand -base64 32`.
# Keep it with your backups — without it those fields can't be read. If unset, a key is derived from AUTH_SECRET.
# DATA_KEY=""

# Secret for the scheduled-jobs timer (deploy/dreamhive-jobs.timer): `openssl rand -hex 24`
CRON_SECRET=""

# WhatsApp Business Platform (Cloud API) — login codes, temporary passwords, reminders.
# Approved templates needed: login_code, temp_password, payment_due, payment_rejected (DEPLOY.md → WhatsApp).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_LANG="en"

# SMS fallback for numbers without WhatsApp: any gateway with a URL like this ({to} and {text} are filled in).
# SMS_GATEWAY_URL="https://sms.example.com/send?api_key=KEY&to={to}&msg={text}"
# SMS_GATEWAY_METHOD="GET"

# Push notifications: `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.org"

# Android app (Trusted Web Activity), see DEPLOY.md → Android app
# ANDROID_PACKAGE="org.dreamhive.app"
# ANDROID_SHA256=""
