# Database file. On a server use an absolute path outside the code folder,
# e.g. DATABASE_URL="file:/var/lib/dreamhive/dreamhive.db"
DATABASE_URL="file:./dev.db"

# Long random string that signs login sessions: generate with `openssl rand -hex 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Where uploaded proofs, receipts and documents are kept (default: ./storage).
# On a server: STORAGE_DIR="/var/lib/dreamhive/storage"
# STORAGE_DIR=""

# Used only by prisma/seed.ts. With SEED_DEMO=0 it creates just the first admin
# and the settings (no demo members), and the admin must set a new password at first login.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PHONE="01700000000"
SEED_ADMIN_EMAIL="admin@society.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# SEED_DEMO=0
# SEED_START_MONTH="2026-01"   # the society's first deposit month
