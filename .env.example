DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="replace-with-a-long-random-string"

# Vercel Blob storage token for animal photo uploads (vercel.com dashboard ->
# Storage -> your Blob store -> .env.local tab; auto-set when deployed on Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Used only by prisma/seed.ts to create the first admin account
SEED_ADMIN_EMAIL="admin@farm.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
